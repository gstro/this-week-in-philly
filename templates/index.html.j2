<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>This Week in Philly</title>
  <style>
    /* Shares report.html.j2's page palette on purpose: this page is one click
       from a report, and it used to hand off from a cool #fafafa/#121212 to
       the report's warm paper, which read as two different sites. */
    :root { --page-bg: #f0ede8; --page-fg: #1c1c1c; --muted: #666; }
    @media (prefers-color-scheme: dark) {
      :root { --page-bg: #1a1815; --page-fg: #ece8e1; --muted: #a8a29a; }
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      max-width: 640px;
      margin: 4rem auto;
      padding: 0 1.5rem;
      color: var(--page-fg);
      background: var(--page-bg);
    }
    h1 { font-size: 1.5rem; }
    ul { padding-left: 1.2rem; }
    li { margin: 0.4rem 0; }
    a { color: var(--page-fg); }
    .empty { color: var(--muted); font-style: italic; }
  </style>
</head>
<body>
  <h1>This Week in Philly</h1>
  <p>Weekly picks for Philadelphia events, curated automatically.</p>
  <h2>Weeks</h2>
  <ul>
{% for week in weeks %}
    <li><a href="{{ week.href }}">{{ week.label }}</a></li>
{% else %}
    <li class="empty">No reports published yet.</li>
{% endfor %}
  </ul>
</body>
</html>
