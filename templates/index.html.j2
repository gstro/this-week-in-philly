<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>This Week in Philly</title>
  <!-- Same link-preview and favicon block as report.html.j2, for the same
       reason: this is the page shared when someone wants the whole archive
       rather than one week. -->
  <meta name="description" content="A weekly guide to Philadelphia — Top 3 picks for every day, curated automatically.">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="This Week in Philadelphia">
  <meta property="og:title" content="This Week in Philly">
  <meta property="og:description" content="A weekly guide to Philadelphia — Top 3 picks for every day, curated automatically.">
  <meta property="og:url" content="{{ site_url }}">
  <link rel="canonical" href="{{ site_url }}">
  <meta name="twitter:card" content="summary">
  <meta name="theme-color" content="#111111">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23111'/%3E%3Cpath d='M16 6.5 18.47 12.6 25.03 13.06 19.99 17.3 21.59 23.68 16 20.2 10.41 23.68 12.01 17.3 7.44 13.06 13.53 12.6Z' fill='%23c9a84c'/%3E%3C/svg%3E">
  <style>
    /* Shares report.html.j2's page palette on purpose: this page is one click
       from a report, and it used to hand off from a cool #fafafa/#121212 to
       the report's warm paper, which read as two different sites. */
    :root { --page-bg: #f0ede8; --page-fg: #1c1c1c; --muted: #666; }
    @media (prefers-color-scheme: dark) {
      :root { --page-bg: #1a1815; --page-fg: #ece8e1; --muted: #a8a29a; }
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      max-width: 640px;
      margin: 4rem auto;
      padding: 0 1.5rem;
      color: var(--page-fg);
      background: var(--page-bg);
    }
    h1 { font-size: 1.5rem; }
    ul { padding-left: 1.2rem; }
    li { margin: 0.4rem 0; }
    a { color: var(--page-fg); }
    a:focus-visible { outline: 2px solid #c9a84c; outline-offset: 2px; border-radius: 2px; }
    .empty { color: var(--muted); font-style: italic; }
  </style>
</head>
<body>
  <h1>This Week in Philly</h1>
  <p>Weekly picks for Philadelphia events, curated automatically.</p>
  <h2>Weeks</h2>
  <ul>
{% for week in weeks %}
    <li><a href="{{ week.href }}">{{ week.label }}</a></li>
{% else %}
    <li class="empty">No reports published yet.</li>
{% endfor %}
  </ul>
</body>
</html>
