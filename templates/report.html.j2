<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>This Week in Philadelphia — {{ date_range }}</title>
  <style>
    /* ── Palette ──
       Every colour in this stylesheet is a token so the dark block below can
       restate the palette and nothing else. The light values are the report's
       original ones, unchanged -- with one exception noted at --feature-meta.

       Dark is not a mechanical inversion. In light the Top 3 card is the
       darkest thing on a pale page; inverting that would sink it into the
       background, so in dark it becomes the most *elevated* surface instead
       (page < card < feature), keeping "raised means important" true in both
       themes. Every dark pair clears WCAG AA (4.5:1) -- measured, not
       eyeballed; the light theme does not, and fixing that is its own slice. */
    :root {
      --page-bg: #f0ede8;
      --page-fg: #1c1c1c;
      --rule: #d8d4ce;
      --rule-soft: #eee;
      --muted: #999;
      --muted-strong: #888;
      --muted-faint: #bbb;
      --gold: #c9a84c;
      --header-bg: #111;
      --header-fg: #fff;
      --card-bg: #fff;
      --card-fg: #1c1c1c;
      --card-venue: #444;
      --card-shadow: rgba(0,0,0,0.06);
      --feature-bg: #1c1c1c;
      --feature-fg: #fff;
      --feature-why: #999;
      --feature-venue: #bbb;
      /* Was #666, the one light value this change moves: 2.97:1 on the Top 3
         card, the only outright unreadable pair in the light theme. #848484
         clears AA at 4.56:1 and stays dimmer than --feature-why, so the
         card's hierarchy is unchanged. */
      --feature-meta: #848484;
      --free: #2d7a3a;
      --sold-out: #c0392b;
      /* The card red, lightened for the dark Top 3 card where #c0392b muddies. */
      --sold-out-feature: #e06a5c;
      --table-fg: #555;
      --source-silent: #c3bfb8;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --page-bg: #1a1815;
        --page-fg: #ece8e1;
        --rule: #3a352e;
        --rule-soft: #2e2a25;
        --muted: #a8a29a;
        --muted-strong: #b5afa6;
        --muted-faint: #918a80;
        --gold: #d7b75f;
        --header-bg: #100f0d;
        --header-fg: #f3efe8;
        --card-bg: #26231f;
        --card-fg: #ece8e1;
        --card-venue: #cfc8bd;
        --card-shadow: rgba(0,0,0,0.45);
        --feature-bg: #2e2a25;
        --feature-fg: #f5f1ea;
        --feature-why: #b9b2a8;
        --feature-venue: #d0c9be;
        --feature-meta: #a59e94;
        --free: #7ec98b;
        --sold-out: #ff8a7a;
        --sold-out-feature: #ff9d8f;
        --table-fg: #cfc8bd;
        --source-silent: #8a8279;
      }
      /* The subtitle sits on --header-bg, which stays near-black in both
         themes, so it needs its own value rather than --muted-strong. */
      .subtitle { color: #9b948b; }
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    /* overflow-wrap inherits, so this one declaration keeps every long string
       (venues carry full street addresses -- 130 chars is real) inside its
       column instead of forcing the page to scroll sideways. */
    body { background: var(--page-bg); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color: var(--page-fg); overflow-wrap: break-word; }

    /* ── Header ── */
    .site-header { background: var(--header-bg); width: 100%; }
    .site-header-inner { max-width: 800px; margin: 0 auto; padding: 1.4rem 1.5rem 1.5rem; }
    .eyebrow { font-size: 0.62rem; text-transform: uppercase; color: var(--gold); letter-spacing: 0.12em; margin-bottom: 0.45rem; }
    h1 { color: var(--header-fg); font-size: 1.9rem; font-weight: 700; margin-bottom: 0.35rem; }
    h1 span { color: var(--gold); }
    .subtitle { color: var(--muted-strong); font-size: 0.82rem; }
    .header-playlist { margin-top: 0.6rem; font-size: 0.75rem; }
    .header-playlist a { color: var(--gold); text-decoration: none; }
    .header-playlist a:hover { text-decoration: underline; }

    /* ── Content wrapper ── */
    .content { max-width: 800px; margin: 0 auto; padding: 1.75rem 1.5rem 3rem; }
    hr.day-sep { border: none; border-top: 1px solid var(--rule); margin: 2.25rem 0; }

    /* ── Day index ──
       Seven links, no JS. The page runs ~11 cards a day across 7 days, which
       is short enough that a sticky bar or a back-to-top button would cost
       more than they return (REPORT_IMPROVEMENTS_BRAINSTORM.md #16, #24, both
       dropped on those grounds) but long enough to want one jump per day. */
    .day-index { display: flex; flex-wrap: wrap; gap: 0.35rem 0.9rem; margin-bottom: 1.75rem; font-size: 0.72rem; }
    .day-index a { color: var(--page-fg); text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: 0.1rem; }
    .day-index a:hover { border-bottom-color: var(--gold); }
    .day-index .day-index-count { color: var(--muted); margin-left: 0.25rem; }

    /* ── Day header ── */
    .day-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; scroll-margin-top: 0.75rem; }
    .day-name { font-size: 0.62rem; text-transform: uppercase; color: var(--muted); letter-spacing: 0.1em; flex-shrink: 0; }
    .day-date { font-size: 1.25rem; font-weight: 700; color: var(--page-fg); flex-shrink: 0; }
    .day-rule { flex: 1; height: 1px; background: var(--rule); }

    /* ── Top 3 card ── */
    .top3-card { background: var(--feature-bg); border-radius: 7px; padding: 1rem 1.25rem; margin-bottom: 0.65rem; }
    .top3-label { font-size: 0.62rem; text-transform: uppercase; color: var(--gold); letter-spacing: 0.1em; margin-bottom: 0.8rem; }
    .top3-pick { display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.9rem; }
    .top3-pick:last-child { margin-bottom: 0; }
    .pick-num { color: var(--gold); font-weight: 700; font-size: 0.9rem; min-width: 1.1rem; padding-top: 0.1rem; flex-shrink: 0; }
    .pick-main { flex: 1; min-width: 0; }
    .pick-name { color: var(--feature-fg); font-weight: 700; font-size: 0.88rem; line-height: 1.3; }
    .pick-name a { color: var(--gold); text-decoration: none; }
    .pick-name a:hover { text-decoration: underline; }
    .pick-name a.event-link { color: var(--feature-fg); }
    .pick-why { color: var(--feature-why); font-size: 0.76rem; margin-top: 0.25rem; line-height: 1.5; }
    /* max-width caps the flex-shrink: 0 column: a venue carrying a full street
       address (130 chars is real) otherwise sizes to its own content and starves
       .pick-main down to one letter per line. */
    .pick-meta { text-align: right; flex-shrink: 0; min-width: 130px; max-width: 50%; }
    .pick-venue { color: var(--feature-venue); font-size: 0.76rem; }
    .pick-venue a { color: inherit; text-decoration: none; }
    .pick-venue a:hover { text-decoration: underline; }
    .pick-time-cost { color: var(--feature-meta); font-size: 0.68rem; margin-top: 0.15rem; }
    .pick-time-cost .sold-out { color: var(--sold-out-feature); font-size: inherit; }

    /* ── Honorable mentions ── */
    p.hm { font-size: 0.77rem; color: var(--muted); font-style: italic; margin-bottom: 1.3rem; line-height: 1.5; }

    /* ── Category header ── */
    .cat-label { font-size: 0.62rem; text-transform: uppercase; color: var(--muted); letter-spacing: 0.08em; display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.55rem; margin-top: 1.1rem; }
    .cat-label::after { content: ''; flex: 1; border-top: 1px solid var(--rule); }

    /* ── Event cards ── */
    .event-card { background: var(--card-bg); border-radius: 5px; padding: 0.5rem 0.75rem; box-shadow: 0 1px 2px var(--card-shadow); display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.35rem; }
    .event-left { flex: 1; min-width: 0; }
    .event-name { font-size: 0.85rem; font-weight: 700; color: var(--card-fg); line-height: 1.3; }
    .event-name a { color: inherit; text-decoration: none; }
    .event-name a:hover { text-decoration: underline; }
    .event-note { font-size: 0.73rem; color: var(--muted); margin-top: 0.15rem; line-height: 1.4; }
    .event-right { text-align: right; flex-shrink: 0; min-width: 120px; max-width: 50%; }
    .event-venue { font-size: 0.78rem; font-weight: 700; color: var(--card-venue); }
    .event-time { font-size: 0.7rem; color: var(--muted); margin-top: 0.1rem; }
    .price-free { font-size: 0.7rem; color: var(--free); }
    .price-paid { font-size: 0.7rem; color: var(--muted); }
    .sold-out { font-size: 0.7rem; color: var(--sold-out); font-weight: 600; }

    /* ── All Week table ── */
    .allweek-label { font-size: 0.62rem; text-transform: uppercase; color: var(--muted); letter-spacing: 0.08em; display: flex; align-items: center; gap: 0.6rem; margin-top: 2.5rem; margin-bottom: 0.75rem; }
    .allweek-label::after { content: ''; flex: 1; border-top: 1px solid var(--rule); }
    .allweek-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
    .allweek-table th { text-align: left; padding: 0.3rem 0.5rem; color: var(--muted-strong); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--rule); }
    .allweek-table td { padding: 0.5rem 0.5rem; border-bottom: 1px solid var(--rule-soft); color: var(--table-fg); vertical-align: top; }
    .allweek-table tr:last-child td { border-bottom: none; }
    .allweek-table td strong { color: var(--page-fg); }

    .cat-omitted { font-size: 0.7rem; color: var(--muted-faint); font-style: italic; margin: 0.15rem 0 0 0.75rem; }

    /* ── Sources footer ── */
    .sources { text-align: center; font-size: 0.7rem; color: var(--muted); margin-top: 3rem; line-height: 2.2; }
    .sources a { color: var(--muted); text-decoration: none; }
    .sources a:hover { color: var(--page-fg); }
    /* Watched but silent this week -- dimmer than a contributor, still legible. */
    .sources a.source-silent { color: var(--source-silent); }
    .source-count { color: var(--source-silent); font-size: 0.62rem; margin-left: 0.2rem; }
    .sources-failure { text-align: center; font-size: 0.7rem; color: var(--muted-faint); margin-top: 0.4rem; }

    /* ── Narrow screens ──
       Every card above is a desktop flex row with a fixed-width, right-aligned
       meta column (130px / 120px). Below ~600px those columns eat a third of a
       phone screen and squeeze the title into a ribbon, so each card wraps its
       meta column onto its own full-width line and left-aligns it. The All Week
       table -- four columns, unfittable at 375px -- becomes stacked cards that
       label themselves from the td data-label attributes. */
    @media (max-width: 600px) {
      .site-header-inner { padding: 1.1rem 1rem 1.2rem; }
      h1 { font-size: 1.5rem; }
      .content { padding: 1.35rem 1rem 2.5rem; }

      .day-header { gap: 0.5rem; }
      .day-date { font-size: 1.1rem; }

      .top3-card { padding: 0.9rem 1rem; }
      .top3-pick { flex-wrap: wrap; }
      /* 1.85rem = .pick-num's 1.1rem min-width + .top3-pick's 0.75rem gap, so
         the meta line hangs under the title rather than under the number. It has
         to be padding, not margin: flex-basis 100% + a left margin would put the
         venue 1.85rem past the card's right edge. */
      .pick-meta { flex-basis: 100%; min-width: 0; max-width: none; text-align: left; margin: 0.3rem 0 0; padding-left: 1.85rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.05rem 0.4rem; }
      .pick-venue { flex-basis: 100%; }
      .pick-time-cost { margin-top: 0; }

      .event-card { flex-wrap: wrap; gap: 0.15rem; }
      .event-right { flex-basis: 100%; min-width: 0; max-width: none; text-align: left; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.05rem 0.4rem; }
      /* Venue on its own line so the time and price below it don't read as a
         continuation of the address. */
      .event-venue { flex-basis: 100%; }
      .event-time { margin-top: 0; }
      /* :not(:empty) -- clean_cost() legitimately yields "" (53 of them in the
         week of 2026-08-10 alone), and the separator must not dangle after the
         time with no price behind it. */
      .event-time + div:not(:empty)::before { content: "·"; color: var(--rule); margin-right: 0.4rem; }

      .allweek-table, .allweek-table tbody, .allweek-table tr, .allweek-table td { display: block; width: 100%; }
      .allweek-table thead { display: none; }
      .allweek-table tr { background: var(--card-bg); border-radius: 5px; box-shadow: 0 1px 2px var(--card-shadow); padding: 0.5rem 0.75rem; margin-bottom: 0.35rem; }
      .allweek-table td { border-bottom: none; padding: 0.1rem 0; }
      .allweek-table td::before { content: attr(data-label) ": "; color: var(--muted); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; }
      .allweek-table td:first-child::before { content: none; }
    }
  </style>
</head>
<body>

<header class="site-header">
  <div class="site-header-inner">
    <div class="eyebrow">Weekly Guide</div>
    <h1>This Week in <span>Philadelphia</span></h1>
    <div class="subtitle">{{ date_range }} &nbsp;·&nbsp; Compiled Sunday</div>
{% if playlist_url %}
    <div class="header-playlist"><a href="{{ playlist_url }}">♫ This week's picks on Spotify</a></div>
{% endif %}
  </div>
</header>

<div class="content">

  <!-- DAY INDEX -->
  <nav class="day-index" aria-label="Jump to a day">
{% for day in days %}
    <a href="#{{ day.slug }}">{{ day.day_name }}<span class="day-index-count">{{ day.event_count }}</span></a>
{% endfor %}
  </nav>
{% for day in days %}
  {% if not loop.first %}
  <hr class="day-sep">
  {% endif %}
  <div class="day-header" id="{{ day.slug }}">
    <span class="day-name">{{ day.day_name }}</span>
    <span class="day-date">{{ day.date_display }}</span>
    <div class="day-rule"></div>
  </div>

  <div class="top3-card">
    <div class="top3-label">⭐ Top 3 Picks</div>
{% for pick in day.top3 %}
    <div class="top3-pick">
      <div class="pick-num">{{ pick.rank }}</div>
      <div class="pick-main">
        <div class="pick-name">{{ pick.name_html | safe }}</div>
        <div class="pick-why">{{ pick.why }}</div>
      </div>
      <div class="pick-meta">
        <div class="pick-venue">{% if pick.map_url %}<a href="{{ pick.map_url }}">{{ pick.venue }}</a>{% else %}{{ pick.venue }}{% endif %}</div>
        <div class="pick-time-cost">{{ pick.time_display }}{% if pick.cost_text %} · {% if pick.sold_out %}<span class="sold-out">{{ pick.cost_text }}</span>{% else %}{{ pick.cost_text }}{% endif %}{% endif %}</div>
      </div>
    </div>
{% endfor %}
  </div>
{% if day.honorable_mentions_html %}

  <p class="hm">Honorable mentions: {{ day.honorable_mentions_html | safe }}</p>
{% endif %}
{% for category in day.categories %}

  <div class="cat-label">{{ category.label }}</div>
{% for event in category.events %}
  <div class="event-card">
    <div class="event-left">
      <div class="event-name">{{ event.name_html | safe }}</div>
{% if event.note %}
      <div class="event-note">{{ event.note }}</div>
{% endif %}
    </div>
    <div class="event-right">
      <div class="event-venue">{{ event.venue }}</div>
      <div class="event-time">{{ event.time_display }}</div>
      <div class="{{ event.price_class }}">{{ event.price_text }}</div>
    </div>
  </div>
{% endfor %}
{% if category.omitted %}
  <p class="cat-omitted">+ {{ category.omitted }} more not shown</p>
{% endif %}
{% endfor %}
{% endfor %}
{% if all_week %}

  <!-- ALL WEEK / RECURRING -->
  <div class="allweek-label">All Week / Recurring</div>
  <table class="allweek-table">
    <thead><tr><th>Event</th><th>Venue</th><th>This week</th><th>Price</th></tr></thead>
{% for row in all_week %}
    <tr>
      <td data-label="Event"><strong>{{ row.title }}</strong></td>
      <td data-label="Venue">{{ row.venue }}</td>
      <td data-label="This week">{{ row.days }}</td>
      <td data-label="Price">{{ row.price_text }}</td>
    </tr>
{% endfor %}
  </table>
{% endif %}

  <!-- SOURCES FOOTER -->
  <div class="sources">
{% for source in sources %}
{% if source.url %}
    <a href="{{ source.url }}"{% if not source.count %} class="source-silent"{% endif %}>{{ source.name }}</a>{% if source.count %}<span class="source-count">{{ source.count }}</span>{% endif %}{{ " ·" if not loop.last else "" }}
{% else %}
    <span>{{ source.name }}</span><span class="source-count">{{ source.count }}</span>{{ " ·" if not loop.last else "" }}
{% endif %}
{% endfor %}
  </div>
{% for failure in collection_failure_notes %}
  <p class="sources-failure">⚠️ {{ failure }} — events from that source may be missing.</p>
{% endfor %}

</div>
</body>
</html>
