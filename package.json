{
  "name": "this-week-in-philly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run check:ts && npm run check:py",
    "check:ts": "npm run typecheck && npm run lint && npm test",
    "check:py": "npm run lint:py && npm run typecheck:py && npm run test:py",
    "lint:py": "scripts/dev/py.sh ruff check scripts/",
    "typecheck:py": "scripts/dev/py.sh mypy",
    "test:py": "scripts/dev/py.sh pytest",
    "setup": "npm ci && npm run setup:py",
    "setup:py": "python3.12 -m venv .venv && .venv/bin/pip install -r scripts/requirements-dev.txt -r scripts/requirements-collection.txt",
    "setup:browsers": "scripts/dev/py.sh playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@types/nunjucks": "^3.2.6",
    "eslint": "^10.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "entities": "7.0.1",
    "googleapis": "^178.0.0",
    "nunjucks": "^3.2.4"
  }
}
