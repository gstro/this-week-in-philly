# Copy to .env (already gitignored) and fill in for local script testing.
# Never commit real values. See scripts/oauth_bootstrap.py for how to get
# the Google values; developer.spotify.com for the Spotify ones.
#
# These seven are consumed by scripts/ (the presentation.yml stage: attendance_
# check.py, spotify_lookup.py, spotify_playlist.py, calendar_create.py). They
# need to be set again, separately, as GitHub Actions repo secrets (Settings >
# Secrets and variables > Actions) for presentation.yml to run for real --
# this .env is for local testing only.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# CLIENT_ID/CLIENT_SECRET are one Spotify app, shared by both Spotify scripts.
# spotify_lookup.py needs only those two (Client Credentials, app-only search).
# spotify_playlist.py additionally needs the two below, because creating a
# playlist requires *user* authorization, which Client Credentials cannot do.
# Get REFRESH_TOKEN from scripts/spotify_oauth_bootstrap.py; REDIRECT_URI must
# byte-match one registered on the app at developer.spotify.com/dashboard
# (Spotify may reject a bare `localhost` host -- use the 127.0.0.1 loopback).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional; defaults to data/event-picks-log.csv (repo-relative) if unset.
# PICKS_LOG_PATH=
